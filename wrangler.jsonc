{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "de5a4f1c-7672-4204-a459-526819f57947","database_name": "app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "99acf801e38745ec80f23f59ab06a29d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
